QUERYAI_VERSION=latest
QUERYAI_HTTP_PORT=8080

POSTGRES_USER=queryai
POSTGRES_DB=queryai
POSTGRES_PASSWORD=change-me

QUERYAI_ADMIN_EMAIL=change-me
QUERYAI_ADMIN_PASSWORD=change-me
QUERYAI_ADMIN_NAME=Administrador

QUERYAI_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
QUERYAI_SESSION_IDLE_HOURS=8
QUERYAI_LOGIN_RATE_LIMIT_PER_MINUTE=10
QUERYAI_ALLOW_INSECURE_HTTP=false

QUERYAI_LOG_LEVEL=Information
QUERYAI_ENABLE_API_DOCS=false
